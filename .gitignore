# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Reports (generated) ---
*_report.md
eval_report.md
forensics_report.md
.qa-screenshots/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.venv/
venv/
env/
build/
dist/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local database artifacts (NOT the db/ source package — that's real
#     application code and must stay tracked; Qdrant is fully cloud-hosted,
#     so there's no local vector-store directory to ignore here) ---
*.sqlite3
*.db

# --- Ingestion-only source material (copyrighted books + derived chunks) ---
# Retrieval hits Qdrant Cloud directly at runtime; teammates running the
# chatbot never need these locally. Ingestion-time only, see SETUP.md.
data/raw/*.pdf
data/processed/*.jsonl
data/processed/**/*.jsonl

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Logs ---
*.log
logs/
