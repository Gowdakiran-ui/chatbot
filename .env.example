# Backend environment — copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# --- Chanakya KB (Qdrant Cloud) ---
chanakya_qdrant_url=              # get from Kiran, do not commit
chanakya_qdrant_api_key=          # get from Kiran, do not commit

# --- Crisis KB (Qdrant Cloud) ---
crisis_planer_qdrant_url=         # get from Kiran, do not commit
crisis_planer_api_key=            # get from Kiran, do not commit

# --- Generation provider (OpenRouter) ---
open_router_api_key=              # get from Kiran, do not commit

# --- CORS ---
# Comma-separated list of origins the browser is allowed to call the API from.
# Empty = nothing allowed (fails closed). For local dev against the Vite dev
# server this is the frontend's own origin:
ALLOWED_ORIGINS=http://localhost:5173

# --- Internal review / dev-mode auth bypass ---
# Set to true for local testing so you don't need an issued token — skips
# auth entirely and treats every request as one shared "Internal Review"
# client. Loud startup warning prints when this is on. Must stay unset/false
# for any real deployment. Leave unset for normal auth-required behavior.
AUTH_DISABLED=true
