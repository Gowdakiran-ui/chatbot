# Frontend environment (Vite). install.bat copies this to .env; .env is git-ignored.

# Base URL of the API. Default is the relative path /api: in dev the Vite proxy forwards it to
# http://localhost:8000 (stripping /api), in production nginx/Caddy does the same. Only set this
# to call a different origin (that origin must then allow CORS for this app).
# VITE_API_BASE_URL=/api

# Mirrors the backend's AUTH_DISABLED flag (see ../.env.example). When true the token-entry screen
# is skipped. Keep in sync with the backend. MUST be false (or unset) for any real deployment.
VITE_AUTH_DISABLED=true
