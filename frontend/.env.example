# Frontend environment — copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# Base URL of the backend API. Local dev default matches the backend's
# default uvicorn port (see start.bat / SETUP.md).
VITE_API_BASE_URL=http://localhost:8000

# Mirrors the backend's AUTH_DISABLED flag (see ../.env.example). When true,
# the token-entry screen is skipped entirely and the app goes straight to
# the chat UI. Keep this in sync with the backend's AUTH_DISABLED value.
VITE_AUTH_DISABLED=true
