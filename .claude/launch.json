{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "serving.app:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-offline",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "eval.offline_app:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "backend-offline-v2",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "eval.offline_app:app",
        "--port",
        "8001"
      ],
      "port": 8001,
      "env": {
        "KB_SNAPSHOT_DIR": "data/snapshots_v3"
      }
    },
    {
      "name": "backend-offline-8000",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "eval.offline_app:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}